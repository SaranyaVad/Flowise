{
    "name": "india-return-app",
    "version": "0.1.0",
    "private": true,
    "description": "Return-to-India relocation guide: schools & fees, rent vs buy, and salary/seniority benchmarks, starting with Hyderabad",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "build:artifact": "tsc -b && vite build --config vite.artifact.config.ts",
        "preview": "vite preview",
        "lint": "eslint src --ext ts,tsx",
        "clean": "rimraf dist .turbo",
        "nuke": "rimraf dist node_modules .turbo"
    },
    "dependencies": {
        "leaflet": "^1.9.4",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-leaflet": "^4.2.1"
    },
    "devDependencies": {
        "@types/leaflet": "^1.9.22",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^4.2.1",
        "rimraf": "^5.0.5",
        "typescript": "^5.4.5",
        "vite": "^5.2.0",
        "vite-plugin-singlefile": "^2.3.3"
    }
}
